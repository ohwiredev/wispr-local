{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wispr Local",
  "version": "1.0.0-alpha",
  "identifier": "com.wispr.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wispr Local - Dashboard",
        "width": 1200,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "transparent": false,
        "decorations": true
      },
      {
        "label": "indicator",
        "title": "Wispr Indicator",
        "width": 300,
        "height": 44,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "shadow": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/wispr-backend/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
